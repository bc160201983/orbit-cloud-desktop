{
  "name": "orbit-desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "dev:web": "vite --host 0.0.0.0 --strictPort",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test:api": "node --test tests/api.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
