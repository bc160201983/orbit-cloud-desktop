# Set these in your hosting provider's environment settings.
NODE_ENV=production
PORT=3001
ORBIT_DATA_DIR=/data/orbit
# A long random setup token. Needed once to create the first administrator.
ORBIT_SETUP_TOKEN=
# Your public HTTPS origin, without a trailing slash.
APP_ORIGIN=https://your-orbit-domain.example
# Use 1 only behind one trusted reverse proxy, such as Render.
TRUST_PROXY=1
